// This is your Prisma schema file,
// learn more about it in the docs: https://pris.ly/d/prisma-schema

generator client {
  provider = "prisma-client-js"
}

datasource db {
  provider = "postgresql"
  url      = env("DATABASE_URL")
}

// ============ 用户模型 ============
model User {
  id            String    @id @default(cuid())
  username      String    @unique
  email         String    @unique
  password      String    // GitHub OAuth 用户存随机值
  role          Role      @default(USER)
  avatar        String?
  bio           String?   // 个人简介
  status        String    @default("active") @map("status") // active | muted | banned
  mutedUntil    DateTime? @map("muted_until")
  postCount     Int       @default(0) @map("post_count")
  commentCount  Int       @default(0) @map("comment_count")
  lastActiveAt  DateTime? @map("last_active_at")
  createdAt     DateTime  @default(now()) @map("created_at")
  updatedAt     DateTime  @updatedAt @map("updated_at")

  // GitHub OAuth
  githubId      String?   @unique @map("github_id")
  githubLogin   String?   @map("github_login")

  posts         Post[]
  comments      Comment[]
  likes         Like[]
  logs          OperationLog[]
  notifications Notification[]

  // OAuth 授权服务
  oauthCodes       OAuthAuthorizationCode[]
  oauthAccessTokens OAuthAccessToken[]

  // 授权码归属
  licenses       License[]

  // 订单
  orders         Order[]

  // 协作项目
  collabProjects      CollabProject[]
  collabMemberships   CollabMember[]
  collabTasks         CollabTask[]
  collabContributions CollabContribution[]

  @@map("User")
}

// 角色枚举
enum Role {
  ADMIN
  USER
}

// ============ 论坛分类模型 ============
model Category {
  id        String  @id @default(cuid())
  name      String
  slug      String  @unique
  icon      String?
  desc      String? // 分类描述
  sortOrder Int     @default(0) @map("sort_order")
  posts     Post[]

  @@map("Category")
}

// ============ 工具模型 ============
model Tool {
  id          String   @id @default(cuid())
  name        String
  description String?
  url         String
  icon        String?
  category    String? // 工具分类标签（开发工具/AI工具/效率工具）
  isActive    Boolean  @default(true) @map("is_active")
  isFeatured  Boolean  @default(false) @map("is_featured") // 是否首页推荐
  needLogin   Boolean  @default(false) @map("need_login") // 是否需要登录
  coverImage  String?  @map("cover_image") // 封面图
  clickCount  Int      @default(0) @map("click_count") // 点击量
  sortOrder   Int      @default(0) @map("sort_order") // 排序值，越大越靠前
  createdAt   DateTime @default(now()) @map("created_at")
  updatedAt   DateTime @updatedAt @map("updated_at")

  @@map("Tool")
}

// ============ 帖子模型 ============
model Post {
  id           String     @id @default(cuid())
  title        String
  content      String // Markdown 内容
  categoryId   String     @map("category_id")
  authorId     String     @map("author_id")
  viewCount    Int        @default(0) @map("view_count")
  likeCount    Int        @default(0) @map("like_count")
  commentCount Int        @default(0) @map("comment_count")
  isPinned     Boolean    @default(false) @map("is_pinned")
  isEssence    Boolean    @default(false) @map("is_essence")
  isLocked     Boolean    @default(false) @map("is_locked") // 锁定后禁止评论
  status       PostStatus @default(DRAFT)
  deletedAt    DateTime?  @map("deleted_at") // 软删除时间
  createdAt    DateTime   @default(now()) @map("created_at")
  updatedAt    DateTime   @updatedAt @map("updated_at")

  category Category @relation(fields: [categoryId], references: [id])
  author   User     @relation(fields: [authorId], references: [id])
  comments Comment[]
  likes    Like[]

  @@index([categoryId])
  @@index([authorId])
  @@index([status])
  @@map("Post")
}

// 帖子状态枚举
enum PostStatus {
  PUBLISHED
  DRAFT
  DELETED
}

// ============ 评论模型 ============
model Comment {
  id         String    @id @default(cuid())
  content    String
  postId     String    @map("post_id")
  authorId   String    @map("author_id")
  parentId   String?   @map("parent_id")
  likeCount  Int       @default(0) @map("like_count")
  isApproved Boolean   @default(true) @map("is_approved") // 是否审核通过
  deletedAt  DateTime? @map("deleted_at") // 软删除时间
  createdAt  DateTime  @default(now()) @map("created_at")
  updatedAt  DateTime  @updatedAt @map("updated_at")

  post    Post     @relation(fields: [postId], references: [id])
  author  User     @relation(fields: [authorId], references: [id])
  parent  Comment? @relation("CommentReplies", fields: [parentId], references: [id])
  replies Comment[] @relation("CommentReplies")
  likes   Like[]

  @@index([postId])
  @@index([authorId])
  @@index([parentId])
  @@map("Comment")
}

// ============ 点赞类型枚举 ============
enum LikeType {
  LIKE
  FAVORITE
}

// ============ 点赞模型 ============
model Like {
  id        String   @id @default(cuid())
  userId    String   @map("user_id")
  postId    String?  @map("post_id")
  commentId String?  @map("comment_id")
  type      LikeType @default(LIKE)
  createdAt DateTime @default(now()) @map("created_at")

  user    User    @relation(fields: [userId], references: [id])
  post    Post?   @relation(fields: [postId], references: [id])
  comment Comment? @relation(fields: [commentId], references: [id])

  // 复合唯一约束，防止重复点赞
  @@unique([userId, postId, commentId])
  @@index([userId])
  @@index([postId])
  @@index([commentId])
  @@map("Like")
}

// ============ 通知模型 ============
model Notification {
  id        String   @id @default(cuid())
  userId    String   @map("user_id") // 接收者
  type      String   // reply | like | system | mention
  title     String
  content   String?
  link      String?  // 点击跳转链接
  isRead    Boolean  @default(false) @map("is_read")
  createdAt DateTime @default(now()) @map("created_at")

  user User @relation(fields: [userId], references: [id], onDelete: Cascade)

  @@index([userId])
  @@index([isRead])
  @@map("Notification")
}

// ============ 操作日志模型 ============
model OperationLog {
  id        String   @id @default(cuid())
  userId    String?  @map("user_id")
  username  String?  // 操作人姓名
  action    String   // 操作类型（create_tool / delete_post / ban_user...）
  target    String?  // 操作对象
  detail    String?  // 详情
  ip        String?  // IP地址
  createdAt DateTime @default(now()) @map("created_at")

  user User? @relation(fields: [userId], references: [id])

  @@index([userId])
  @@index([action])
  @@map("OperationLog")
}

// ============ 系统设置模型 ============
model SystemSetting {
  id        String   @id @default(cuid())
  key       String   @unique
  value     String   // JSON存储
  updatedAt DateTime @updatedAt @map("updated_at")

  @@map("SystemSetting")
}

// ============ OAuth 授权服务 - 应用模型 ============
model OAuthApp {
  id           String   @id @default(cuid())
  name         String   // 应用名称
  clientId     String   @unique @map("client_id")
  clientSecret String   @map("client_secret")
  redirectUris String   @map("redirect_uris") // JSON 数组格式
  description  String?
  homepage     String?  // 应用主页 URL
  logo         String?  // 应用 Logo URL
  status       String   @default("active") @map("status") // active | disabled
  createdAt    DateTime @default(now()) @map("created_at")
  updatedAt    DateTime @updatedAt @map("updated_at")

  authCodes    OAuthAuthorizationCode[]
  accessTokens OAuthAccessToken[]

  @@map("OAuthApp")
}

// ============ OAuth 授权服务 - 授权码模型 ============
model OAuthAuthorizationCode {
  id          String   @id @default(cuid())
  appId       String   @map("app_id")
  userId      String   @map("user_id")
  code        String   @unique
  redirectUri String   @map("redirect_uri")
  scope       String?  // 授权范围，空格分隔
  expiresAt   DateTime @map("expires_at")
  used        Boolean  @default(false)
  createdAt   DateTime @default(now()) @map("created_at")

  app  OAuthApp @relation(fields: [appId], references: [id], onDelete: Cascade)
  user User     @relation(fields: [userId], references: [id], onDelete: Cascade)

  @@index([appId])
  @@index([userId])
  @@map("OAuthAuthorizationCode")
}

// ============ OAuth 授权服务 - 访问令牌模型 ============
model OAuthAccessToken {
  id        String   @id @default(cuid())
  appId     String   @map("app_id")
  userId    String   @map("user_id")
  token     String   @unique
  scope     String?  // 授权范围
  expiresAt DateTime @map("expires_at")
  createdAt DateTime @default(now()) @map("created_at")

  app  OAuthApp @relation(fields: [appId], references: [id], onDelete: Cascade)
  user User     @relation(fields: [userId], references: [id], onDelete: Cascade)

  @@index([appId])
  @@index([userId])
  @@map("OAuthAccessToken")
}

// ============ 授权系统 - 授权码表 ============
model License {
  id            String   @id @default(cuid())
  licenseKey    String   @unique @map("license_key") // 授权码
  projectName   String   @map("project_name") // 所属项目名称
  projectType   String   @default("standard") @map("project_type") // 套餐类型: basic | standard | premium | enterprise
  maxDomains    Int      @default(1) @map("max_domains") // 最大绑定域名数
  expiresAt     DateTime @map("expires_at") // 有效期限
  status        String   @default("active") @map("status") // active | suspended | expired | revoked
  remark        String?  // 备注（客户信息等）
  ownerId       String?  @map("owner_id") // 归属用户 ID（可空，管理员生成可不指定）
  productId     String?  @map("product_id") // 关联产品（可空）
  orderId       String?  @map("order_id") // 关联订单（可空，手动创建的无订单）- 普通字段
  createdAt     DateTime @default(now()) @map("created_at")
  updatedAt     DateTime @updatedAt @map("updated_at")

  owner         User?    @relation(fields: [ownerId], references: [id], onDelete: SetNull)
  product       Product? @relation(fields: [productId], references: [id], onDelete: SetNull)
  order         Order?   @relation("OrderLicense") // 反向关系（通过 Order.licenseId 关联）
  domains       LicenseDomain[]
  logs          LicenseLog[]

  @@index([status])
  @@index([projectType])
  @@index([ownerId])
  @@index([productId])
  @@index([orderId])
  @@map("License")
}

// ============ 授权系统 - 授权域名表 ============
model LicenseDomain {
  id              String   @id @default(cuid())
  licenseId       String   @map("license_id")
  domain          String   @unique // 绑定的域名
  activatedAt     DateTime @default(now()) @map("activated_at") // 首次激活时间
  lastVerifiedAt  DateTime? @map("last_verified_at") // 最后验证时间
  createdAt       DateTime @default(now()) @map("created_at")

  license         License  @relation(fields: [licenseId], references: [id], onDelete: Cascade)

  @@index([licenseId])
  @@index([domain])
  @@map("LicenseDomain")
}

// ============ 授权系统 - 授权验证日志表 ============
model LicenseLog {
  id          String   @id @default(cuid())
  licenseId   String?  @map("license_id") // 可为空（授权码不存在时）
  licenseKey  String   @map("license_key") // 请求的授权码
  domain      String   // 请求的域名
  ip          String?  // 请求 IP
  userAgent   String?  @map("user_agent") // 用户代理
  result      String   // valid | invalid | expired | suspended | domain_mismatch | not_found
  message     String?  // 详细信息
  createdAt   DateTime @default(now()) @map("created_at")

  license     License? @relation(fields: [licenseId], references: [id], onDelete: SetNull)

  @@index([licenseId])
  @@index([licenseKey])
  @@index([domain])
  @@index([result])
  @@map("LicenseLog")
}

// ============ 产品销售系统 - 产品表 ============
model Product {
  id            String   @id @default(cuid())
  name          String   // 产品名称
  slug          String   @unique // URL 标识
  tagline       String   // 一句话描述
  description   String   // 详细介绍（Markdown）
  icon          String?  // 产品图标（emoji 或 URL）
  coverImage    String?  @map("cover_image") // 封面图 URL
  features      String?  // 功能特性（JSON 数组）
  techStack     String?  @map("tech_stack") // 技术栈（JSON 数组）
  screenshots   String?  // 截图（JSON 数组 URL）
  demoUrl       String?  @map("demo_url") // 演示地址
  docsUrl       String?  @map("docs_url") // 文档地址
  status        String   @default("active") @map("status") // active | draft | retired
  sortOrder     Int      @default(0) @map("sort_order") // 排序（越大越靠前）
  // 定价（按套餐）
  priceBasic    Int      @default(0) @map("price_basic") // 基础版价格（分）
  priceStandard Int      @default(0) @map("price_standard") // 标准版价格（分）
  pricePremium   Int      @default(0) @map("price_premium") // 高级版价格（分）
  priceEnterprise Int    @default(0) @map("price_enterprise") // 企业版价格（分）
  validDays     Int      @default(365) @map("valid_days") // 默认授权有效期（天）
  downloadUrl   String?  @map("download_url") // 购买后下载链接
  createdAt     DateTime @default(now()) @map("created_at")
  updatedAt     DateTime @updatedAt @map("updated_at")

  versions      ProductVersion[]
  licenses      License[]
  orders        Order[]

  @@index([status])
  @@map("Product")
}

// ============ 产品销售系统 - 版本表 ============
model ProductVersion {
  id            String   @id @default(cuid())
  productId     String   @map("product_id")
  version       String   // 版本号，如 v1.0.0
  title         String   // 版本标题
  changelog     String   // 更新日志（Markdown）
  downloadUrl   String   @map("download_url") // 下载链接
  downloadPassword String? @map("download_password") // 下载密码（可选）
  fileSize      String?  @map("file_size") // 文件大小描述
  isLatest      Boolean  @default(false) @map("is_latest") // 是否为最新版本
  isPublished   Boolean  @default(true) @map("is_published") // 是否已发布
  createdAt     DateTime @default(now()) @map("created_at")

  product       Product  @relation(fields: [productId], references: [id], onDelete: Cascade)

  @@index([productId])
  @@index([isLatest])
  @@map("ProductVersion")
}

// ============ 产品销售系统 - 订单表 ============
model Order {
  id            String   @id @default(cuid())
  orderNo       String   @unique @map("order_no") // 订单号
  userId        String   @map("user_id")
  productId     String   @map("product_id")
  productName   String   @map("product_name") // 快照
  projectType   String   @map("project_type") // basic | standard | premium | enterprise
  maxDomains    Int      @map("max_domains") // 域名配额
  amount        Int      // 金额（分）
  validDays     Int      @map("valid_days") // 授权有效期（天）
  status        String   @default("pending") @map("status") // pending | paid | approved | rejected | refunded | cancelled
  payMethod     String?  @map("pay_method") // alipay | wechat | manual
  payTxId       String?  @map("pay_tx_id") // 第三方交易号
  paidAt        DateTime? @map("paid_at") // 支付时间
  licenseId     String?  @unique @map("license_id") // 支付后生成的授权码 ID
  remark        String?  // 备注
  createdAt     DateTime @default(now()) @map("created_at")
  updatedAt     DateTime @updatedAt @map("updated_at")

  user          User     @relation(fields: [userId], references: [id], onDelete: Cascade)
  product       Product  @relation(fields: [productId], references: [id], onDelete: Cascade)
  license       License? @relation("OrderLicense", fields: [licenseId], references: [id], onDelete: SetNull)

  @@index([userId])
  @@index([productId])
  @@index([status])
  @@map("Order")
}

// ============ 监控统计 - 每日用量 ============
model MonitoringDaily {
  id                  String   @id @default(cuid())
  date                DateTime @db.Date
  functionInvocations Int      @default(0) @map("function_invocations")
  edgeRequests        Int      @default(0) @map("edge_requests")
  cpuTimeMs           Int      @default(0) @map("cpu_time_ms")
  dataTransferBytes   BigInt   @default(0) @map("data_transfer_bytes")
  createdAt           DateTime @default(now()) @map("created_at")
  updatedAt           DateTime @updatedAt @map("updated_at")

  @@unique([date])
  @@map("MonitoringDaily")
}

// ============ 监控统计 - 路由级别明细 ============
model MonitoringRoute {
  id                  String   @id @default(cuid())
  date                DateTime @db.Date
  path                String
  method              String
  requestCount        Int      @default(0) @map("request_count")
  totalCpuMs          Int      @default(0) @map("total_cpu_ms")
  totalDataBytes      BigInt   @default(0) @map("total_data_bytes")
  createdAt           DateTime @default(now()) @map("created_at")
  updatedAt           DateTime @updatedAt @map("updated_at")

  @@unique([date, path, method])
  @@index([date])
  @@map("MonitoringRoute")
}

// ============ 外部数据库管理 ============
model ExternalDatabase {
  id          String   @id @default(cuid())
  name        String   @unique // 数据库别名（如 "用户数据库"、"日志数据库"）
  description String?  // 描述
  dbType      String   @default("postgresql") @map("db_type") // 数据库类型: postgresql | mysql (预留)
  host        String   // 主机地址
  port        Int      @default(5432) // 端口
  database    String   // 数据库名
  username    String   // 用户名
  password    String   // 密码（加密存储）
  sslMode     String   @default("prefer") @map("ssl_mode") // disable | prefer | require
  status      String   @default("active") @map("status") // active | disabled | error
  lastCheckedAt DateTime? @map("last_checked_at") // 最后检测时间
  lastCheckOk  Boolean? @map("last_check_ok") // 最后检测结果
  createdAt   DateTime @default(now()) @map("created_at")
  updatedAt   DateTime @updatedAt @map("updated_at")

  @@map("ExternalDatabase")
}

// ============ GitHub 协作项目 - 召集令 ============
model CollabProject {
  id            String   @id @default(cuid())
  title         String   // 召集令标题
  description   String   // 项目描述（Markdown）
  authorId      String   @map("author_id") // 发起人

  // GitHub 仓库信息
  repoUrl       String   @map("repo_url") // GitHub 仓库完整 URL
  repoOwner     String   @map("repo_owner") // 仓库所有者（GitHub 用户名/组织）
  repoName      String   @map("repo_name") // 仓库名称
  repoCreated   Boolean  @default(false) @map("repo_created") // 是否通过本平台创建（true=OAuth创建，false=手动添加）
  defaultBranch String?  @map("default_branch") // 默认分支

  // 项目元信息
  techStack     String?  @map("tech_stack") // 技术栈（JSON 数组）
  tags          String?  // 标签（JSON 数组）
  goals         String?  // 项目目标（Markdown）
  requirements  String?  // 参与要求描述

  // 状态管理
  status        String   @default("recruiting") // recruiting | active | completed | archived
  maxMembers    Int      @default(10) @map("max_members") // 最大成员数

  // 统计字段（冗余，提升查询性能）
  memberCount        Int  @default(1) @map("member_count")
  taskCount          Int  @default(0) @map("task_count")
  completedTaskCount Int  @default(0) @map("completed_task_count")
  contributionCount  Int  @default(0) @map("contribution_count")
  viewCount          Int  @default(0) @map("view_count")

  createdAt     DateTime @default(now()) @map("created_at")
  updatedAt     DateTime @updatedAt @map("updated_at")

  author        User              @relation(fields: [authorId], references: [id])
  members       CollabMember[]
  tasks         CollabTask[]
  contributions CollabContribution[]

  @@index([authorId])
  @@index([status])
  @@map("CollabProject")
}

// ============ GitHub 协作项目 - 成员 ============
model CollabMember {
  id          String   @id @default(cuid())
  projectId   String   @map("project_id")
  userId      String   @map("user_id")
  role        String   @default("member") // owner | maintainer | member
  status      String   @default("active") // pending | active | left
  githubLogin String?  @map("github_login") // 成员的 GitHub 用户名（用于关联提交）
  joinedAt    DateTime @default(now()) @map("joined_at")
  leftAt      DateTime? @map("left_at")

  project     CollabProject @relation(fields: [projectId], references: [id], onDelete: Cascade)
  user        User          @relation(fields: [userId], references: [id])

  @@unique([projectId, userId])
  @@index([projectId])
  @@index([userId])
  @@map("CollabMember")
}

// ============ GitHub 协作项目 - 任务清单 ============
model CollabTask {
  id          String   @id @default(cuid())
  projectId   String   @map("project_id")
  title       String
  description String?  // 任务描述（Markdown）
  assigneeId  String?  @map("assignee_id")
  status      String   @default("open") // open | in_progress | review | completed | cancelled
  priority    String   @default("medium") // low | medium | high | urgent
  labels      String?  // 标签（JSON 数组）
  dueDate     DateTime? @map("due_date")
  sortOrder   Int      @default(0) @map("sort_order")
  createdAt   DateTime @default(now()) @map("created_at")
  updatedAt   DateTime @updatedAt @map("updated_at")
  completedAt DateTime? @map("completed_at")

  project        CollabProject       @relation(fields: [projectId], references: [id], onDelete: Cascade)
  assignee       User?               @relation(fields: [assigneeId], references: [id])
  contributions  CollabContribution[]

  @@index([projectId])
  @@index([assigneeId])
  @@index([status])
  @@map("CollabTask")
}

// ============ GitHub 协作项目 - 提交贡献 ============
model CollabContribution {
  id          String   @id @default(cuid())
  projectId   String   @map("project_id")
  taskId      String?  @map("task_id")
  userId      String   @map("user_id")

  // 提交信息
  type        String   // commit | pull_request | issue | docs | other
  title       String   // 提交标题
  description String?  // 提交描述
  url         String?  // GitHub commit/PR/issue 链接
  commitSha   String?  @map("commit_sha") // commit SHA（前 7 位）
  branch      String?  // 分支名
  additions   Int      @default(0) // 新增行数
  deletions   Int      @default(0) // 删除行数
  filesChanged Int     @default(0) @map("files_changed")

  status      String   @default("pending") // pending | approved | rejected
  createdAt   DateTime @default(now()) @map("created_at")

  project     CollabProject @relation(fields: [projectId], references: [id], onDelete: Cascade)
  task        CollabTask?   @relation(fields: [taskId], references: [id], onDelete: SetNull)
  user        User          @relation(fields: [userId], references: [id])

  @@index([projectId])
  @@index([taskId])
  @@index([userId])
  @@map("CollabContribution")
}
