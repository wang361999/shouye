# ============================================================
# ET Studio 环境变量配置
# ============================================================
# 部署到 Vercel 时，在 项目设置 → Environment Variables 中配置以下变量
# 本地开发时，复制此文件为 .env.local 并填写实际值
# ============================================================

# ---- 数据库连接（必需）----
# 推荐使用 Neon (https://neon.tech) 免费 PostgreSQL 数据库
# 格式：postgresql://用户名:密码@主机:端口/数据库名?schema=public
DATABASE_URL="postgresql://user:password@localhost:5432/ethhy?schema=public"

# ---- JWT 密钥（必需）----
# 用于签发和验证用户登录令牌，请使用足够长的随机字符串
# 可用命令生成：openssl rand -base64 32
JWT_SECRET="your-super-secret-jwt-key-change-in-production"

# ---- 应用 URL ----
# 站点访问地址，部署后改为实际域名
NEXT_PUBLIC_APP_URL="http://localhost:3000"

# ---- 管理员账号（可选，仅首次播种时使用）----
# 部署构建时会自动创建管理员账号，如不配置则使用默认值
# 建议生产环境修改默认密码
ADMIN_USERNAME="admin"
ADMIN_PASSWORD="admin123"
ADMIN_EMAIL="admin@ethhy.com"

# ============================================================
# GitHub API Token（用于代码搜索和嵌入功能）
# ============================================================
# GitHub Code Search API 强制要求认证，必须配置此变量
# 创建方式：https://github.com/settings/tokens → Generate new token (classic)
# 只需勾选 public_repo（只读公开仓库）即可，无需其他权限
# 配置后速率限制从 60/h 提升至 5000/h
GITHUB_TOKEN="ghp_your_github_personal_access_token"

# ============================================================
# GitHub OAuth 登录配置
# ============================================================
# 方式一（推荐）：在后台 安全设置 页面直接配置，无需修改环境变量
# 方式二：通过环境变量配置（后台未设置时回退使用）
#
# 1. 前往 https://github.com/settings/developers 创建一个 OAuth App
# 2. Homepage URL 填写站点地址（如 http://localhost:3000）
# 3. Authorization callback URL 填写：http://localhost:3000/api/auth/github/callback
#    （生产环境替换为实际域名）
# 4. 将生成的 Client ID 和 Client Secret 填入下方或后台安全设置页
GITHUB_CLIENT_ID="your-github-client-id"
GITHUB_CLIENT_SECRET="your-github-client-secret"

# ============================================================
# OAuth 授权服务说明（本站作为 OAuth Provider）
# ============================================================
# 本站内置 OAuth 2.0 授权服务，其他应用可通过本站进行 SSO 登录。
#
# 管理方式：
#   后台 → 系统设置 → OAuth 应用 → 创建应用
#
# 接入端点：
#   授权端点:  GET  /api/oauth/authorize
#   令牌端点:  POST /api/oauth/token
#   用户信息:  GET  /api/oauth/userinfo
#   应用信息:  GET  /api/oauth/app-info?client_id=xxx
#
# 授权流程（Authorization Code）:
#   1. 第三方应用重定向用户到 /api/oauth/authorize?response_type=code&client_id=xxx&redirect_uri=xxx&scope=user:read&state=xxx
#   2. 用户在授权同意页选择同意或拒绝
#   3. 同意后重定向回 redirect_uri?code=xxx&state=xxx
#   4. 第三方应用后端用 code 调用 /api/oauth/token 获取 access_token
#   5. 用 access_token 调用 /api/oauth/userinfo 获取用户信息
