# ============================================================
# Gitd 环境变量配置
# ============================================================
# 部署到 Cloudflare Workers 时，在 Dashboard → Workers → your-worker →
#   Settings → Variables 中配置以下变量
# 部署到 Vercel 时，在 项目设置 → Environment Variables 中配置
# 本地开发时，复制此文件为 .env.local 并填写实际值
# ============================================================

# ---- 数据库连接（必需）----
# 推荐 Turso (https://turso.tech) 免费 SQLite 数据库（9GB 免费存储）
# 格式：libsql://数据库名.区域.turso.io
DATABASE_URL="libsql://your-db.turso.io"
# Turso 访问令牌（在 Turso Dashboard → Settings → Tokens 中创建）
DATABASE_AUTH_TOKEN="eyJhbGciOiJFZERTQSIsInR5cCI6..."

# ---- JWT 密钥（必需）----
# 用于签发和验证用户登录令牌，请使用足够长的随机字符串
# 可用命令生成：openssl rand -base64 32
JWT_SECRET="your-super-secret-jwt-key-change-in-production"

# ---- 应用 URL ----
# 站点访问地址，部署后改为实际域名
# Cloudflare 部署时会自动注入 CF_PAGES_URL，无需手动配置
NEXT_PUBLIC_APP_URL="http://localhost:3000"

# ---- 可选：一键部署 Deploy Hook ----
# Cloudflare: Dashboard → Workers → your-worker → Settings → Builds → Deploy Hooks
# Vercel: Dashboard → Settings → Git → Deploy Hooks
CLOUDFLARE_DEPLOY_HOOK_URL=""
# VERCEL_DEPLOY_HOOK_URL=""  # Vercel 部署时使用

# ---- 可选：邮件发送（Resend API）----
# Cloudflare Workers 不支持 SMTP（TCP），请使用 Resend API 发送邮件
# 1. 在 https://resend.com 注册并获取 API Key
# 2. 在 Resend 后台验证你的发件域名
# 3. 将 API Key 和发件地址填入下方环境变量
RESEND_API_KEY=""
RESEND_FROM_EMAIL="noreply@yourdomain.com"

# ---- 可选：站内监控追踪密钥 ----
MONITOR_INTERNAL_SECRET="your-monitor-internal-secret"

# ---- 可选：AI 功能（Gemini / OpenAI 兼容）----
# 用于 AI 润色发帖、AI 推荐标签等功能
# 推荐使用 Google Gemini（免费额度足够小站使用）
# 获取地址：https://aistudio.google.com/apikey
AI_API_KEY=""
# API 端点（OpenAI 兼容格式），Gemini 用默认值即可
AI_API_BASE="https://generativelanguage.googleapis.com/v1beta/openai/chat/completions"
# 模型名称
AI_MODEL="gemini-3.6-flash"

# ---- 可选：AI 自动迭代执行器 ----
AI_ITERATION_WEBHOOK_URL=""

# ---- 管理员账号（可选，仅首次播种时使用）----
ADMIN_USERNAME="admin"
ADMIN_PASSWORD="admin123"
ADMIN_EMAIL="admin@ethhy.com"

# ---- Vercel 部署 Token（可选）----
# 用于自动触发 Vercel 部署
VERCEL_TOKEN=""

# ============================================================
# GitHub API Token（用于代码搜索和嵌入功能）
# ============================================================
# 创建方式：https://github.com/settings/tokens
# fine-grained token 建议给当前仓库开启 Contents 只读、Issues 读写
GITHUB_TOKEN="ghp_your_github_personal_access_token"

# ============================================================
# GitHub OAuth 登录配置
# ============================================================
# 方式一（推荐）：在后台 安全设置 页面直接配置
# 方式二：通过环境变量配置（后台未设置时回退使用）
GITHUB_CLIENT_ID="your-github-client-id"
GITHUB_CLIENT_SECRET="your-github-client-secret"

# ============================================================
# Cloudflare Workers 构建设置（已内置在 .env 文件中，无需修改）
# ============================================================
# 以下变量告诉 Wrangler/esbuild 使用 node 条件解析包导出
# 对于包含 workerd 专用代码的包（如 @libsql/client）是必需的
WRANGLER_BUILD_CONDITIONS=""
WRANGLER_BUILD_PLATFORM="node"

# ============================================================
# OAuth 授权服务说明（本站作为 OAuth Provider）
# ============================================================
# 后台 → 系统设置 → OAuth 应用 → 创建应用
# 授权端点:  GET  /api/oauth/authorize
# 令牌端点:  POST /api/oauth/token
# 用户信息:  GET  /api/oauth/userinfo
# 应用信息:  GET  /api/oauth/app-info?client_id=xxx
